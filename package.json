{
  "name": "mayorista-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:cloudflare": "tsc -b && VITE_API_URL=https://pupas-mayorista-api.onrender.com vite build",
    "cloudflare:dev": "npm run build:cloudflare && WRANGLER_LOG_PATH=.wrangler/logs/wrangler.log npx --yes wrangler@4.80.0 dev",
    "cloudflare:deploy": "npm run build:cloudflare && WRANGLER_LOG_PATH=.wrangler/logs/wrangler.log npx --yes wrangler@4.80.0 deploy",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^6.4.3"
  }
}
